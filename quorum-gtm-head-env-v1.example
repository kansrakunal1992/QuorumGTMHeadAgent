# ── Quorum GTM Head — Environment Variables ─────────────────────────────
# Copy this file's structure into Railway → Project → Variables.
# Nothing in this project should ever be committed with real values.

# ─── Supabase (REUSE the SAME project as the main Quorum app — do not
#     create a new Supabase project; copy these two values across from the
#     main app's own Railway variables) ───────────────────────────────────
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ─── AI provider (default: DeepSeek V4 Pro) ────────────────────────────
AI_PROVIDER=deepseek
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-pro
# Only needed if you set AI_PROVIDER=openai_compatible instead:
# AI_PROVIDER_API_KEY=
# AI_PROVIDER_BASE_URL=
# AI_PROVIDER_MODEL=

# ─── Admin / cron auth (generate two long random strings — e.g.
#     `openssl rand -hex 24` — do not reuse the main app's ADMIN_CODE) ───
ADMIN_CODE=
CRON_SECRET=

# ─── Autonomy & guardrails ──────────────────────────────────────────────
GTM_AUTONOMY_MODE=full                 # full | conservative | research_only
GTM_DAILY_SPEND_CAP_INR=0              # 0 = no autonomous ad-spend authority yet

# Per-category daily caps — all optional, defaults shown are the spec's own
GTM_LIMIT_TOTAL_ACTIONS=100
GTM_LIMIT_PROSPECTS_RESEARCHED=50
GTM_LIMIT_OUTREACH_MESSAGES=15
GTM_LIMIT_FOLLOW_UPS=10
GTM_LIMIT_LINKEDIN_COMMENTS=20
GTM_LIMIT_LINKEDIN_POSTS=2
GTM_LIMIT_INSTAGRAM_POSTS=1
GTM_LIMIT_WHATSAPP_OUTREACH=10
GTM_LIMIT_WHATSAPP_STATUS=1
GTM_LIMIT_EMAIL_OUTREACH=15
GTM_LIMIT_EXPERIMENTS=2
GTM_LIMIT_COMPETITOR_RESEARCH=5

# ─── Lead sourcing (discover -> LLM-qualify -> enrich) ──────────────────
# Apollo: Settings -> Integrations -> API Keys -> Create -> scope the key to
# "People Search" ONLY (nothing else needed; free plan is enough to start).
APOLLO_API_KEY=
# Hunter: hunter.io -> API -> API Key. Free plan = 50 credits/month, no card.
HUNTER_API_KEY=
# Comma-separated region codes to prospect in: IN, US, EU, AE
PROSPECT_REGIONS=IN,US,EU,AE
# Of everything discovered, how many may survive LLM qualification per day
# (and therefore get enriched + queued for outreach). Kept deliberately
# small — the scarce resource is learning signal, not lead volume.
GTM_LIMIT_PROSPECTS_QUALIFIED_PER_DAY=20

# ─── Optional: live web research (Research Agent has no browser of its own
#     — without this it explicitly reports "no live source" rather than
#     guessing). Get a key at tavily.com (has a free tier). ──────────────
TAVILY_API_KEY=

# ─── Optional: only set these once you have a REAL, official, compliant
#     integration — until then these channels correctly stay Founder
#     Actions (Level C) no matter what GTM_AUTONOMY_MODE says. There is no
#     compliant personal-profile API for LinkedIn, so linkedin has no
#     autonomous path at all — it's intentionally absent from this list. ─
WHATSAPP_BUSINESS_TOKEN=
INSTAGRAM_GRAPH_TOKEN=
RESEND_API_KEY=
GTM_EMAIL_AUTONOMOUS=false             # set true to actually send outreach emails automatically (not just draft them)
# Required if GTM_EMAIL_AUTONOMOUS=true — the "From" address, must be on a
# domain already verified in this Resend account. Fastest: reuse the same
# domain the main app already sends from. Better long-term: verify a
# subdomain (e.g. hello.quorumvault.org) in Resend so cold-outreach bounce/
# spam-complaint rates never touch the main app's transactional reputation.
GTM_EMAIL_FROM=
# Strongly recommended — a REAL inbox you actually check. GTM_EMAIL_FROM is
# often a send-only address with no monitored inbox behind it (e.g. an
# auth@ address used for magic links); without this, replies may go
# nowhere. Set it to your own email so replies land where you'll see them.
GTM_EMAIL_REPLY_TO=
# Optional — appended to every autonomous email. Defaults to a plain
# "reply to opt out" line if unset. For real volume, consider adding your
# business's physical postal address here (CAN-SPAM requirement in the US).
GTM_EMAIL_FOOTER=

# ─── Optional: real prospect data source — without this, prospecting is a
#     deliberate no-op (never invents named people). ─────────────────────
PROSPECT_DATA_SOURCE_API_KEY=

# ─── Optional: cosmetic / used in generated content and links ──────────
QUORUM_MARKETING_URL=https://quorumvault.org
QUORUM_APP_URL=
# Live ₹299 founder-led Decision Session booking page — used as a CTA in
# content/outreach drafts aimed at conversion. Defaults to the real page if unset.
QUORUM_BOOKING_URL=https://quorumvault.org/kunal
# Live FREE 30-min founder-led session — the default CTA for cold first-touch
# outreach (lower friction than asking a stranger for money upfront).
QUORUM_FREE_SESSION_URL=https://quorumvault.org/kunal_elite
